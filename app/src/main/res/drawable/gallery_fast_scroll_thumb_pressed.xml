<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="@dimen/gallery_fast_scroll_handle_size"
                android:height="@dimen/gallery_fast_scroll_handle_size" />
            <solid android:color="#FFA998FF" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/gallery_fast_scroll_arrows"
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</layer-list>
